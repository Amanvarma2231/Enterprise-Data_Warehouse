# =============================================================================
# RetailSphere Enterprise Data Warehouse Environment Configuration Template
# =============================================================================

# Application Environment (development / staging / production)
APP_ENV=development
DEBUG=True

# Local PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retailsphere_dw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_CONNECTION_STRING=postgresql://postgres:your_secure_password_here@localhost:5432/retailsphere_dw

# MySQL OLTP Source Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=retailsphere_oltp
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_CONNECTION_STRING=mysql+pymysql://root:your_mysql_password@localhost:3306/retailsphere_oltp

# MongoDB NoSQL Source Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=retailsphere_nosql

# DuckDB Warehouse Path
DUCKDB_DATABASE_PATH=data/warehouse/retailsphere_dw.duckdb

# Google Cloud BigQuery Configuration (Optional Cloud Deployment)
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=retailsphere_dw
GOOGLE_APPLICATION_CREDENTIALS=config/gcp-service-account-key.json

# Snowflake Configuration (Optional)
SNOWFLAKE_ACCOUNT=your_account_id
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=RETAILSPHERE_DW
SNOWFLAKE_SCHEMA=WAREHOUSE

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
